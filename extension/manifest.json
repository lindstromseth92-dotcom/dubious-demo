{
  "manifest_version": 3,
  "name": "Dubious",
  "version": "0.1.0",
  "description": "Scan a page for dubious claims. Underlines what doesn't hold up and shows the evidence behind each score.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8787/*", "http://127.0.0.1:8787/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dubious: scan this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
